    "notes": [
      {
        "category": "summary",
        "text": "Security update for alsa",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for alsa fixes the following issues:\n\n- CVE-2026-96674: computation of combined topology element size using 32-bit arithmetic in `src/topology/ctl.c` allows\n  for integer overflow that can cause sensitive data leak and application crashes (bsc#1282564).\n- CVE-2026-96675: failure to validate sparse binding indices before array access when processing ALSA configuration\n  files can lead to an assertion failure and an application abort (bsc#1282563).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-2026-4735,SUSE-SLE-Micro-5.5-2026-4735",
        "title": "Patchnames"
