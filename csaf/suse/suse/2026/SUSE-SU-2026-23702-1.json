  "vulnerabilities": [
    {
      "cve": "CVE-2026-80179",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-80179"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in jwcrypto. A remote attacker can send a specially crafted JSON Web Encryption (JWE) token containing numerous period delimiters. This malformed token can force the JWE.deserialize() function to allocate excessive memory, leading to a MemoryError. This issue results in a denial of service (DoS) for services that process untrusted JWE values.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "SUSE Linux Enterprise Server 16.0:python313-jwcrypto-0:1.5.6-160000.4.1.noarch",
          "SUSE Linux Enterprise Server for SAP applications 16.0:python313-jwcrypto-0:1.5.6-160000.4.1.noarch"
        ]
      },
