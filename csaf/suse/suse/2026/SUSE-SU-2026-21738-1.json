  "vulnerabilities": [
    {
      "cve": "CVE-2026-44933",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-44933"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "`PluginScript` attempts to `chroot` the plugin to the `repoManagerRoot`, this root is frequently `/` (the system root) in standard configurations or when using `--root`. If the chroot target is `/`, it is a no-op, allowing the traversed path to execute host binaries (like `/bin/bash`) with root privileges.",
          "title": "CVE description"
        }
      ],
      "product_status": {
