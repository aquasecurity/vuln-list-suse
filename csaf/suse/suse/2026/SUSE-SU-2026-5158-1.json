  "vulnerabilities": [
    {
      "cve": "CVE-2026-117557",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-117557"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "SDL_image through 3.4.8 and through 2.8.12 contains a stack out-of-bounds read vulnerability in IMG_LoadLBM_IO() in src/IMG_lbm.c that skips bitplane count validation when HAM mode is set. Attackers can supply a crafted ILBM file with more than 8 HAM bitplanes to read past the colormap stack array, causing crashes or disclosing stack memory.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
