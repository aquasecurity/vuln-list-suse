  "vulnerabilities": [
    {
      "cve": "CVE-2026-78322",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-78322"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in file-roller. When opening or extracting a malicious 7z or RAR archive containing a file entry with an excessively long path, file-roller's progress-line parsing copies the path into a fixed-size stack buffer using an unbounded string copy. This can trigger a stack buffer overflow and cause file-roller to terminate, resulting in a denial of service. To exploit this flaw, a victim must open or extract the crafted archive using file-roller.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "SUSE Linux Enterprise High Performance Computing 12 SP5:file-roller-0:3.20.3-15.12.1.x86_64",
          "SUSE Linux Enterprise High Performance Computing 12 SP5:file-roller-lang-0:3.20.3-15.12.1.noarch",
          "SUSE Linux Enterprise High Performance Computing 12 SP5:nautilus-file-roller-0:3.20.3-15.12.1.x86_64",
          "SUSE Linux Enterprise Server 12 SP5:file-roller-0:3.20.3-15.12.1.x86_64",
          "SUSE Linux Enterprise Server 12 SP5:file-roller-lang-0:3.20.3-15.12.1.noarch",
