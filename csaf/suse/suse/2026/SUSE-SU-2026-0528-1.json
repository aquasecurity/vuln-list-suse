    "notes": [
      {
        "category": "summary",
        "text": "Security update for the Linux Kernel (Live Patch 24 for SUSE Linux Enterprise 15 SP5)",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "\nThis update for the SUSE Linux Enterprise kernel 5.14.21-150500.55.97 fixes various security issues\n\nThe following security issues were fixed:\n\n- CVE-2023-53321: wifi: mac80211_hwsim: drop short frames (bsc#1250314).\n- CVE-2025-38111: net/mdiobus: Fix potential out-of-bounds read/write access (bsc#1249455).\n- CVE-2025-38352: posix-cpu-timers: fix race between handle_posix_cpu_timers() and posix_cpu_timer_del() (bsc#1249205).\n- CVE-2025-39742: RDMA: hfi1: fix possible divide-by-zero in find_hw_thread_mask() (bsc#1249480).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-2026-528,SUSE-2026-530,SUSE-2026-531,SUSE-2026-532,SUSE-2026-534,SUSE-SLE-Module-Live-Patching-15-SP4-2026-530,SUSE-SLE-Module-Live-Patching-15-SP5-2026-534",
        "title": "Patchnames"
