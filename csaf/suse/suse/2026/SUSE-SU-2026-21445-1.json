    "notes": [
      {
        "category": "summary",
        "text": "Security update for avahi",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for avahi fixes the following issues:\n\n- CVE-2025-68276: reachable assertion in `avahi_wide_area_scan_cache` can lead to an `avahi-daemon` crash (bsc#1256498).\n- CVE-2025-68468: reachable assertion in `lookup_multicast_callback` can lead to an `avahi-daemon` crash (bsc#1256499).\n- CVE-2025-68471: reachable assertion in `lookup_start` can lead to an `avahi-daemon` crash (bsc#1256500).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-SLE-Micro-6.1-509",
        "title": "Patchnames"
      },
