    "notes": [
      {
        "category": "summary",
        "text": "Security update for cpio",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for cpio fixes the following issues:\n\n- CVE-2026-66484: improper sanitization in the tar archive extraction functionality allows for the creation of hard\n  links outside intended directory via malicious tar archives (bsc#1274856).\n- CVE-2026-66485: improper memory management in the `make_path` function when allocating memory allows for denial of\n  service via crafted archives (bsc#1274857).\n- CVE-2026-66486: improper encoding or escaping of output in the archive member listing functionality allows for\n  terminal control sequence injection via crafted archive member names (bsc#1274858).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-SL-Micro-6.2-1595",
        "title": "Patchnames"
