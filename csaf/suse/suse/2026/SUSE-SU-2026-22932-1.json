    "notes": [
      {
        "category": "summary",
        "text": "Security update for avahi",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for avahi fixes the following issues:\n\n- CVE-2025-59529: local DoS due to simple protocol server ignoring client limit CLIENTS_MAX (bsc#1255451).\n\nChanges for avahi:\n\n- Make /var/lib/avahi-autoipd a ghost dir instead of packaging it\n since avahi-autoipd creates it on start (jsc#PED-14836).\n- Use libalternative instead of update-alternatives in TW and SLFO\n (jsc#PED-14835).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-SL-Micro-6.2-1328",
        "title": "Patchnames"
      },
