  "vulnerabilities": [
    {
      "cve": "CVE-2026-34956",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-34956"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in Open vSwitch. When Open vSwitch is configured with a conntrack flow using FTP helpers over the userspace datapath, a remote attacker can send a specially crafted FTP stream with an EPASV command exceeding 255 characters. This heap access error can lead to a crash, resulting in a Denial of Service (DoS) for the affected system.",
          "title": "CVE description"
        }
      ],
