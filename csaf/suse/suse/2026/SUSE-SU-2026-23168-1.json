    "notes": [
      {
        "category": "summary",
        "text": "Security update for libssh",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for libssh fixes the following issues\n\n- CVE-2026-59843: denial of service via zero advertised channel packet size (bsc#1272164).\n- CVE-2026-59844: denial of service via oversized SFTP read length (bsc#1272165).\n- CVE-2026-59845: denial of service via unchecked ProxyCommand fork() failure (bsc#1272166).\n- CVE-2026-59846: information disclosure via ProxyCommand %r username expansion (bsc#1272167).\n- CVE-2026-59847: integrity downgrade via OpenSSL AES-GCM tag verification (bsc#1272168).\n- CVE-2026-59848: denial of service via SFTP responses with unknown request IDs (bsc#1272169).\n- CVE-2026-59850: use-after-free via data callbacks on closed channels (bsc#1272171).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-SLE-Micro-6.1-659",
        "title": "Patchnames"
      },
