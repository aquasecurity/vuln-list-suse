    "notes": [
      {
        "category": "summary",
        "text": "Security update for opensc",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for opensc fixes the following issues:\n\n- CVE-2023-5992: Side-channel leaks while stripping encryption PKCS#1 padding (bsc#1219386).\n- CVE-2024-8443: Heap buffer overflow in OpenPGP driver when generating key (bsc#1230364).\n- CVE-2024-45620: Incorrect handling of the length of buffers or files in pkcs15init (bsc#1230076).\n- CVE-2024-45619: Incorrect handling length of buffers or files in libopensc (bsc#1230075).\n- CVE-2024-45618: Uninitialized values after incorrect or missing checking return values of functions in pkcs15init (bsc#1230074).\n- CVE-2024-45617: Uninitialized values after incorrect or missing checking return values of functions in libopensc (bsc#1230073).\n- CVE-2024-45616: Uninitialized values after incorrect check or usage of APDU response values in libopensc (bsc#1230072).\n- CVE-2024-45615: Usage of uninitialized values in libopensc and pkcs15init (bsc#1230071).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-SLE-Micro-6.1-248",
        "title": "Patchnames"
      },
