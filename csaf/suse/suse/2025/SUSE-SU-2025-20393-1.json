    "notes": [
      {
        "category": "summary",
        "text": "Security update for docker",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for docker fixes the following issues:\n\nAlways clear SUSEConnect suse_* secrets when starting containers regardless\nof whether the daemon was built with SUSEConnect support. Not doing this\ncauses containers from SUSEConnect-enabled daemons to fail to start when\nrunning with SUSEConnect-disabled (i.e. upstream) daemons.\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "SUSE-SLE-Micro-6.1-134",
        "title": "Patchnames"
      },
