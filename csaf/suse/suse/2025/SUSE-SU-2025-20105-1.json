  "vulnerabilities": [
    {
      "cve": "CVE-2024-52530",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2024-52530"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "GNOME libsoup before 3.6.0 allows HTTP request smuggling in some configurations because '\\0' characters at the end of header names are ignored, i.e., a \"Transfer-Encoding\\0: chunked\" header is treated the same as a \"Transfer-Encoding: chunked\" header.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "SUSE Linux Micro 6.0:libsoup-3_0-0-0:3.4.2-5.1.aarch64",
          "SUSE Linux Micro 6.0:libsoup-3_0-0-0:3.4.2-5.1.s390x",
