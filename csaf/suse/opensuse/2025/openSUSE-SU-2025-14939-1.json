      ],
      "notes": [
        {
          "category": "general",
          "text": "Synapse is an open source Matrix homeserver implementation. A malicious server can craft events which, when received, prevent Synapse version up to 1.127.0 from federating with other servers. The vulnerability has been exploited in the wild and has been fixed in Synapse v1.127.1. No known workarounds are available.",
          "title": "CVE description"
        }
      ],
