      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2025-23390"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A vulnerability has been identified within Fleet where, by default, Fleet will automatically trust a remote server's certificate when connecting through SSH if the certificate isn't set in the `known_hosts` file. This could allow the execution of a man-in-the-middle (MitM) attack against Fleet. In case the server that is being connected to has a trusted entry in the known_hosts file, then Fleet will correctly check the authenticity of the presented certificate.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:govulncheck-vulndb-0:0.0.20250506T153719-1.1.aarch64",
