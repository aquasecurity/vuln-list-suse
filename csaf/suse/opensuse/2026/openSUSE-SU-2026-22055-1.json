    "notes": [
      {
        "category": "summary",
        "text": "Security update for libX11",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for libX11 fixes the following issues:\n\n- CVE-2026-94283: out-of-bounds read vulnerability in libX11's XIM (X Input Method) attribute parser (bsc#1281653).\n- CVE-2026-94284: out-of-bounds read vulnerability in libX11's XIM trigger-keyregistration parser.registration parser\n  (bsc#1281657).\n- CVE-2026-94285: out-of-bounds read in libX11's byte-oriented codeset parser (bsc#1281661).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "openSUSE-Leap-16.0-1868",
        "title": "Patchnames"
