      "cve": "CVE-2026-110855",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-110855"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "GitPython before 3.2.0 contains an information disclosure vulnerability that allows malicious repositories to expand environment variables via separate_git_dir in Repo._clone(), which omits expand_vars=False when calling Git.polish_url(). Attackers can craft a .gitmodules submodule name containing variable syntax so that clone plus submodule_update exposes secrets in .git/modules directory names and DEBUG logs.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
