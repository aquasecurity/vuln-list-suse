  "vulnerabilities": [
    {
      "cve": "CVE-2026-93006",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-93006"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in dnsmasq. The TFTP server can serve the wrong file contents because a recently used transfer cache is not invalidated when a transfer finishes. An attacker on the local network who can request a TFTP file may cause a later client to receive previously cached data instead of the requested file. In PXE network-boot environments this can substitute attacker-chosen boot content for a victim machine.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
