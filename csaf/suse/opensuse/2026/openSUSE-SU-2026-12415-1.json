    {
      "cve": "CVE-2026-93008",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-93008"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in dnsmasq. When following a CNAME in a DNS response, the resolver can cache records for the CNAME target without checking that those records belong to the responding server's authorized zone. In split-DNS deployments that send some domains to a specific upstream, an attacker who controls that upstream can inject cache entries for unrelated names. Later clients may then receive attacker-chosen addresses for those names.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:dnsmasq-0:2.93-3.1.aarch64",
          "openSUSE Tumbleweed:dnsmasq-0:2.93-3.1.ppc64le",
