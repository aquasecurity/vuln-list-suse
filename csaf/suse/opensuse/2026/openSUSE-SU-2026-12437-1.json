  "vulnerabilities": [
    {
      "cve": "CVE-2026-120678",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-120678"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A memory management flaw in the MongoDB C Driver's handling of compressed responses may cause the client library to hold on to memory that is never released. An unauthenticated party that controls the database endpoint a client application connects to may cause repeated, unbounded memory growth in that application, which may result in the application becoming unavailable. No credentials, transport security settings, or user interaction are required.",
          "title": "CVE description"
        }
      ],
