      "cve": "CVE-2026-129927",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-129927"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A credential-handling weakness in the MongoDB Python Driver allows a configuration option value that protects private key material to be written in clear text into the embedding application's own output and log records when a driver object is converted to text. A party able to read that output may obtain the credential. Obtaining it requires read access to the application's local output or log files.",
          "title": "CVE description"
        }
      ],
