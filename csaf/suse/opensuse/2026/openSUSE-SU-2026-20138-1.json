    "notes": [
      {
        "category": "summary",
        "text": "Security update for jasper",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for jasper fixes the following issues:\n\nUpdate to 4.2.8:\n\n- CVE-2025-8837: Fixed a bug in the JPC decoder that could cause bad memory accesses if the debug level is set sufficiently high (bsc#1247901).\n- CVE-2025-8836: Added some missing range checking on several coding parameters in the JPC encoder (bsc#1247902).\n- CVE-2025-8835: Added a check for a missing color component in the jas_image_chclrspc function (bsc#1247904).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "openSUSE-Leap-16.0-223",
        "title": "Patchnames"
