  "vulnerabilities": [
    {
      "cve": "CVE-2026-121885",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-121885"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in Podman. An attacker can trigger a Denial of Service (DoS) by supplying a container image containing crafted metadata labels. Podman's auto-update mechanism improperly trusts these image labels to determine which system services to restart. If a user runs the malicious container and auto-update processes it, arbitrary system services are restarted with the user's privileges, potentially allowing an attacker to shut down the host system when Podman runs with administrative privileges.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:podman-0:6.2.0-1.1.aarch64",
          "openSUSE Tumbleweed:podman-0:6.2.0-1.1.ppc64le",
          "openSUSE Tumbleweed:podman-0:6.2.0-1.1.s390x",
          "openSUSE Tumbleweed:podman-0:6.2.0-1.1.x86_64",
