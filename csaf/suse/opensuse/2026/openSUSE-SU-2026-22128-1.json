  "vulnerabilities": [
    {
      "cve": "CVE-2026-26824",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-26824"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "libxls through version 1.6.3 contains a use of uninitialized memory vulnerability in the OLE container parser. Memory allocated for the Master Sector Allocation Table (MSAT) in read_MSAT() is not fully initialized before being consumed by ole2_validate_sector_chain(), which may result in application crashes or potential information disclosure when processing a crafted XLS file",
          "title": "CVE description"
        }
      ],
