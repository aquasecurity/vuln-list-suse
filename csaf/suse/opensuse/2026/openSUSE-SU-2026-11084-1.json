  "vulnerabilities": [
    {
      "cve": "CVE-2026-9648",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-9648"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "The crypton-x509-validation Haskell library fails to enforce X.509 NameConstraints, allowing TLS clients to accept certificates whose Subject Alternative Names fall outside the issuing CA's permitted subtrees. This oversight enables an attacker who compromises a name-constrained sub-CA to impersonate domains beyond its intended scope.",
          "title": "CVE description"
        }
      ],
