  "vulnerabilities": [
    {
      "cve": "CVE-2026-116131",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-116131"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "HTTP::Body versions before 1.23_01 for Perl allow memory and temporary file exhaustion via an unlimited number of form fields and multipart parts.\n\nThe urlencoded parser splits the whole body on its separators at once, creating one scalar per separator before any field is stored. This costs about 90 bytes of memory per separator byte. The multipart parser creates a temporary file for every part that carries a filename. Neither parser limits how many fields or parts a body may hold.\n\nA remote attacker can exhaust worker memory with a body made of separators, or create thousands of temporary files with one request of small file parts.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:perl-HTTP-Body-0:1.240.0-1.1.aarch64",
          "openSUSE Tumbleweed:perl-HTTP-Body-0:1.240.0-1.1.ppc64le",
          "openSUSE Tumbleweed:perl-HTTP-Body-0:1.240.0-1.1.s390x",
