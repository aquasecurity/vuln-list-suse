  "vulnerabilities": [
    {
      "cve": "CVE-2026-4367",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-4367"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in libXpm. A local user with low privileges could exploit an Out-of-Bounds Read vulnerability in the `xpmNextWord()` function by processing a specially crafted or very small XPM (X PixMap) image file. This improper validation of file boundaries can cause an internal pointer to read beyond the file's end, leading to application crashes and Denial of Service conditions.",
          "title": "CVE description"
        }
      ],
