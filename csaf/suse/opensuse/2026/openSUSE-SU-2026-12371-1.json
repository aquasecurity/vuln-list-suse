      "cve": "CVE-2026-112909",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-112909"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "filelock is a platform-independent file lock for Python. Prior to 4.2.1, UnixFileLock can truncate a regular file renamed onto the lock path when another local user has actual rename permission, or hard-linked there under a permissive hard-link policy; when an explicit mode is requested, affected versions from 3.10.2 can also change that file's mode. This issue is fixed in version 4.2.1.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
