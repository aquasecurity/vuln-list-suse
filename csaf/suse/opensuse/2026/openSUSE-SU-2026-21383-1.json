      "cve": "CVE-2026-42052",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-42052"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "Beets is the media library management system. Prior to version 2.10.0, the bundled web UI uses Underscore template interpolation mode \u003c%= ... %\u003e for untrusted metadata fields. In this runtime, \u003c%= ... %\u003e is raw insertion and HTML escaping is only performed by \u003c%- ... %\u003e. Rendered output is then inserted with .html(...), allowing attacker-controlled markup to become active DOM. This issue has been patched in version 2.10.0.",
          "title": "CVE description"
        }
      ],
