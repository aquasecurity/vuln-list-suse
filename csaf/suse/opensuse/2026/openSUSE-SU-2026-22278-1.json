    {
      "cve": "CVE-2026-114582",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-114582"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "An issue was discovered in Django 6.1 before 6.1.3, 6.0 before 6.0.10, and 5.2 before 5.2.19.\n`django.contrib.gis.gdal.SpatialReference` (and related `transform()` methods and `srs`/`srid` setters) do not restrict GDAL's file and network access when parsing string input, which allows attackers to trigger server-side requests or local file reads via crafted spatial reference strings.\nEarlier, unsupported Django series (such as 5.1.x, 5.0.x, and 4.2.x) were not evaluated and may also be affected.\nDjango would like to thank Adraca for reporting this issue.",
          "title": "CVE description"
        }
      ],
