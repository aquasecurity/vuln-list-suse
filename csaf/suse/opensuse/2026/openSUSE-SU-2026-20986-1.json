        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "Crypt::SaltedHash versions through 0.09 for Perl generate insecure random values for salts.\n\nThese versions use the built-in rand function, which is predictable and unsuitable for cryptography.",
          "title": "CVE description"
        }
      ],
      "product_status": {
