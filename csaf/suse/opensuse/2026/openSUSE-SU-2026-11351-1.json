    {
      "cve": "CVE-2026-57074",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-57074"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "XML::Bare versions through 0.53 for Perl have an unbounded character lookahead.\n\nThe parserc_parse function attempts to check for multicharacter strings such as \"\u003c![CDATA\" or element terminators such as \"\u003e\" without checking that the offsets are within the buffer.\n\nTruncated strings such as \"\u003ca/\" can trigger an out-of-bounds read.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:perl-XML-Bare-0:0.53-7.1.aarch64",
