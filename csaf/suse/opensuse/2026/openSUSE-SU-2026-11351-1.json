  "vulnerabilities": [
    {
      "cve": "CVE-2026-13401",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-13401"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "XML::Bare versions through 0.53 for Perl will hang in an infinite loop when parsing malformed attributes.\n\nThe parserc_parse function never advances the attribute-parse state cursor on certain malformed attribute forms, looping forever.\n\nNameless attributes such as \"\u003ca ='c'\u003e\" or unbalanced quotes \"\u003ca b='''''''c'\u003e\" can trigger this condition.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:perl-XML-Bare-0:0.53-7.1.aarch64",
