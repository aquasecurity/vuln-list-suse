    {
      "cve": "CVE-2026-101283",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-101283"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "iperf3 3.20-3.21 (esnet/iperf) has a pre-auth heap buffer overflow in decrypt_rsa_message(): a 256-byte RSA buffer is BIO_read with the attacker-controlled ciphertext length (guard warns only), so an unauthenticated client overflows the heap via an oversized authtoken; fixed in 3.22",
          "title": "CVE description"
        }
      ],
      "product_status": {
