  "vulnerabilities": [
    {
      "cve": "CVE-2021-33640",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2021-33640"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "After tar_close(), libtar.c releases the memory pointed to by pointer t. After tar_close() is called in the list() function, it continues to use pointer t: free_longlink_longname(t-\u003eth_buf) . As a result, the released memory is used (use-after-free).",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
