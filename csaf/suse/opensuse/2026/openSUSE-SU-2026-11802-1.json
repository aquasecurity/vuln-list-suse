        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in pppd. A remote attacker could exploit a buffer overflow vulnerability in the PEAP response handling. By sending a specially crafted PEAP Request packet, an attacker could cause the pppd process to corrupt global static data, leading to incorrect behavior or a system crash.",
          "title": "CVE description"
        }
      ],
