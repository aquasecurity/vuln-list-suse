    "notes": [
      {
        "category": "summary",
        "text": "Security update for gpg2",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for gpg2 fixes the following issues:\n\n- CVE-2026-24882: stack-based buffer overflow in TPM2 PKDECRYPT for TPM-backed RSA and ECC keys (bsc#1257396).\n- CVE-2026-24883: denial of service due to long signature packet length causing parse_signature to return success with sig-\u003edata[] set to a NULL value (bsc#1257395).\n- gpg.fail/filename: GnuPG Accepts Path Separators and Path Traversals in Literal Data \"Filename\" Field (bsc#1256389).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "openSUSE-Leap-16.0-221",
        "title": "Patchnames"
