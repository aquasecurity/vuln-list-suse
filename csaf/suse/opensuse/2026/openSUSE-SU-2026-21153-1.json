    "notes": [
      {
        "category": "summary",
        "text": "Security update for xar",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for xar fixes the following issues:\n\nChanges in xar:\n\n- Switch to the maintained Apple xar lineage (build 503, versioned\n  1.8.0.0.503): the mackyle 1.6.1 fork this package tracked has been\n  dead since 2012, and Debian, Fedora and Gentoo all moved to Apple's\n  xar (apple-oss-distributions/xar). This resolves the long-standing\n  NULL-pointer dereferences in xar_get_path() and xar_unserialize()\n  when parsing malformed archives:\n  * CVE-2017-11124 (boo#1047875)\n  * CVE-2017-11125 (boo#1047874)\n  * CVE-2018-17093 (boo#1108595)\n  * CVE-2018-17094 (boo#1108596)\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "openSUSE-Leap-16.0-packagehub-348",
        "title": "Patchnames"
      },
