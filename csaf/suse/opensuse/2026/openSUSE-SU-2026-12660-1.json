  "vulnerabilities": [
    {
      "cve": "CVE-2026-111600",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-111600"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "UNIX symbolic link (symlink) following vulnerability in Apache BuildStream allows source plugins to inadvertently read or write files on the host, with the privileges of the user running BuildStream, via symlinks from malicious or compromised source archives or respositories, as part of source fetching.\n\nThe impact of this issue is mitigated by:\n\n  *  BuildStream projects should only use trusted sources in their elements as otherwise the build output can also not be trusted\n  *  None of the source plugins in the buildstream, buildstream-plugins or buildstream-plugins-community repositories use the vulnerable  `open_file`  method\n\n\nThis issue affects Apache BuildStream: through 2.8.1.\n\nUsers are recommended to upgrade to version 2.8.2, which fixes the issue.",
          "title": "CVE description"
        }
      ],
