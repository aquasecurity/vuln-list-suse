    "notes": [
      {
        "category": "summary",
        "text": "Security update for docker-stable",
        "title": "Title of the patch"
      },
      {
        "category": "description",
        "text": "This update for docker-stable fixes the following issues:\n\n- Enable SELinux in default daemon.json config (--selinux-enabled).\n  This has no practical impact on non-SELinux systems (bsc#1252290).\n- Remove git-core recommends on SLE. Most SLE systems have installRecommends=yes\n  by default and thus end up installing git with Docker (bsc#1250508).\n- Include historical changelog data from before the docker-stable fork.\n  This includes CVE numbers for security tracking reasons (bsc#1250596).\n",
        "title": "Description of the patch"
      },
      {
        "category": "details",
        "text": "openSUSE-Leap-16.0-304",
        "title": "Patchnames"
      },
