  "vulnerabilities": [
    {
      "cve": "CVE-2026-115943",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-115943"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "Spreadsheet::XLSX versions before 0.19 for Perl allow code execution via string eval of number format conditions in ExcelFmt.\n\nWhen a number format has a condition such as [\u003e100], ExcelFmt chooses the format section by passing the condition and the cell value to a string eval. Both come from the workbook, and the eval runs while Spreadsheet::XLSX-\u003enew parses it.\n\nAn attacker who supplies an XLSX file can run arbitrary Perl code.",
          "title": "CVE description"
        }
      ],
