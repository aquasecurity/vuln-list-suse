      "notes": [
        {
          "category": "general",
          "text": "Crypt::PBKDF2 versions before 0.261630 for Perl are vulnerable to timing attacks.\n\nThese versions use Perl's built-in eq comparison. Discrepancies in timing could be used to guess the underlying derived-key.",
          "title": "CVE description"
        }
