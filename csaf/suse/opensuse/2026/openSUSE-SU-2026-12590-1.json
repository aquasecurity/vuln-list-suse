  "vulnerabilities": [
    {
      "cve": "CVE-2026-113495",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-113495"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in cockpit-machines. Red Hat Subscription Management (RHSM) authentication tokens are passed as command-line arguments to background helper processes during image retrieval operations. A local, unprivileged attacker on a system permitting cross-user process inspection can view these arguments while the process is active. This flaw can lead to information disclosure, potentially allowing unauthorized access to RHSM resources within the token's validity period.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:cockpit-machines-0:360-1.1.aarch64",
          "openSUSE Tumbleweed:cockpit-machines-0:360-1.1.ppc64le",
