    {
      "cve": "CVE-2026-113496",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-113496"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "A flaw was found in cockpit-machines. When saving Virtual Network Computing (VNC) console settings, the configured password is passed directly as a command-line argument to an underlying system utility. A local unprivileged attacker on a host that allows cross-user process inspection could read the exposed password from the process list while another user modifies settings. This credential disclosure can allow unauthorized access to the guest virtual machine's graphical console.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:cockpit-machines-0:360-1.1.aarch64",
          "openSUSE Tumbleweed:cockpit-machines-0:360-1.1.ppc64le",
