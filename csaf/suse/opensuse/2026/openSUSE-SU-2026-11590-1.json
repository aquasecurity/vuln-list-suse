      ],
      "notes": [
        {
          "category": "general",
          "text": "Tor before 0.4.9.11 is prone to a use-after-free (and potential double free) of a conflux object when a recovery leg revives a conflux set whose last linked leg has already been closed. A malicious exit node could use this to crash a client. This is TROVE-2026-026.",
          "title": "CVE description"
        }
      ],
