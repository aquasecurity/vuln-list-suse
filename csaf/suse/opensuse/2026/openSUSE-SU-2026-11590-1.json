  "vulnerabilities": [
    {
      "cve": "CVE-2026-77584",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-77584"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "Tor before 0.4.9.10 did not reject a CONFLUX_LINK cell that arrives on a circuit which already has attached streams. A malicious client could send a RELAY_COMMAND_BEGIN before the CONFLUX_LINK on the same circuit, attaching an exit stream that would later end up orphan leaving a dangling circuit back-pointer and a use-after-free (UAF) when the circuit is freed. This is TROVE-2026-025.",
          "title": "CVE description"
        }
      ],
      "product_status": {
        "recommended": [
          "openSUSE Tumbleweed:tor-0:0.4.9.11-1.1.aarch64",
          "openSUSE Tumbleweed:tor-0:0.4.9.11-1.1.ppc64le",
