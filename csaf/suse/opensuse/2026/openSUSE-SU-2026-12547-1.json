  "vulnerabilities": [
    {
      "cve": "CVE-2026-112275",
      "ids": [
        {
          "system_name": "SUSE CVE Page",
          "text": "https://www.suse.com/security/cve/CVE-2026-112275"
        }
      ],
      "notes": [
        {
          "category": "general",
          "text": "Netpbm through 11.16.00 contains a heap out-of-bounds write vulnerability in the rasttopnm Sun rasterfile run-length decoder pr_load_image in converter/other/rast.c. Attackers can supply a byte-encoded rasterfile with tiny dimensions and a long run-length body to write controlled bytes past md_image, causing memory corruption and crashes.",
          "title": "CVE description"
        }
      ],
